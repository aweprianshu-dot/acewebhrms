    match /monitoringAgentStatus/{uid} {
      allow get: if isVerified() && (request.auth.uid == uid || isSuperAdmin() || isHR() || (isDeptLeadOrManager() && resource.data.departmentId == myDepartmentId()));
      allow list: if isVerified() && (request.auth.uid == uid || resource.data.uid == request.auth.uid || isSuperAdmin() || isHR() || (isDeptLeadOrManager() && resource.data.departmentId == myDepartmentId()));
      allow create, update, delete: if false;
    }

    match /monitoringSnapshots/{snapshotId} {
      allow get: if isVerified() && isValidId(snapshotId) && (
        isSuperAdmin() || isHR() || resource.data.uid == request.auth.uid || (isDeptLeadOrManager() && resource.data.departmentId == myDepartmentId())
      );
      allow list: if isVerified() && (
        isSuperAdmin() || isHR() || resource.data.uid == request.auth.uid || (isDeptLeadOrManager() && resource.data.departmentId == myDepartmentId())
      );
      allow create, update, delete: if false;
    }

    match /shiftTemplates/{templateId} {
      allow get, list: if isActiveMember() && isValidId(templateId);
      allow create: if (isSuperAdmin() || isHR()) && isValidId(templateId)
        && incoming().id == templateId
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100
        && incoming().startTime is string && incoming().startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && incoming().endTime is string && incoming().endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isSuperAdmin() || isHR()) && isValidId(templateId)
        && incoming().id == existing().id && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() || isHR();
    }

    match /shiftAssignments/{assignmentId} {
      allow get, list: if isVerified() && (
        isSuperAdmin() || isHR() || (isDeptLeadOrManager() && resource.data.departmentId == myDepartmentId()) || resource.data.uid == request.auth.uid
      );
      allow create: if isVerified() && isValidId(assignmentId)
        && (isSuperAdmin() || isHR() || (isDeptLeadOrManager() && incoming().departmentId == myDepartmentId()))
        && incoming().id == assignmentId && isValidId(incoming().uid)
        && incoming().shiftTemplateId is string && incoming().effectiveFrom is string
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(assignmentId)
        && (isSuperAdmin() || isHR() || (isDeptLeadOrManager() && existing().departmentId == myDepartmentId()))
        && incoming().id == existing().id && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() || isHR();
    }

    match /reviewCycles/{cycleId} {
      allow get, list: if isActiveMember() && isValidId(cycleId);
      allow create: if (isSuperAdmin() || isHR()) && isValidId(cycleId)
        && incoming().id == cycleId
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 120
        && incoming().status in ['active', 'closed', 'upcoming']
        && incoming().kpis is list && incoming().kpis.size() <= 20
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isSuperAdmin() || isHR()) && isValidId(cycleId)
        && incoming().id == existing().id && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() || isHR();
    }

    match /leaveResetLogs/{logId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create: if (isSuperAdmin() || isHR()) && isValidId(logId)
        && incoming().id == logId && incoming().executedByUid == request.auth.uid
        && incoming().year is number && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || isHR());
      allow list: if isSuperAdmin() || isHR();
      allow create: if isVerified() && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /backupHistory/{backupId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin() && isValidId(backupId)
        && isValidBackupRecord(incoming())
        && incoming().id == backupId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Existing WorkFlow OS collections preserved non-destructively (read-scoped, never overwritten by ACE HRMS)
    match /organisations/{orgId} {
      allow get: if isVerified() && isValidId(orgId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /teamDirectory/{memberId} {
      allow get: if isActiveMember() && isValidId(memberId);
      allow list: if isActiveMember() && (isSuperAdmin() || isHR() || resource.data.uid == request.auth.uid || resource.data.email == request.auth.token.email);
      allow create, update, delete: if false;
    }

    match /projects/{projectId} {
      allow get, list: if isActiveMember();
      allow create, update, delete: if false;
    }

    match /activityLogs/{logId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create, update, delete: if false;
    }

    match /seoClients/{docId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create, update, delete: if false;
    }

    match /seoKeywords/{docId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create, update, delete: if false;
    }

    match /seoRankingHistory/{docId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create, update, delete: if false;
    }

    match /seoTrafficSnapshots/{docId} {
      allow get, list: if isSuperAdmin() || isHR();
      allow create, update, delete: if false;
    }
  }
}
