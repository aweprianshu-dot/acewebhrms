# Server configuration
PORT=3000
NODE_ENV=development
APP_URL=
CUSTOM_DOMAIN=

# Firebase (optional override; defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=
# Optional server-only Firebase Admin service account JSON (leave blank to use Application Default Credentials)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_VAPID_KEY=

# Outbound SMTP email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Desktop monitoring screenshot retention (30-90 days)
MONITORING_RETENTION_DAYS=60

# API Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=120

# Optional Slack & WhatsApp Cloud API integrations
SLACK_WEBHOOK_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

